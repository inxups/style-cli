  "documentation_checker": {
    "source": "from pathlib import Path\nimport re, subprocess, urllib.parse, unicodedata\nroot=Path.cwd()\npaths=[root/p for p in subprocess.check_output(['git','diff','--name-only','6ec25f6'],text=True).splitlines() if p.endswith('.md')]\nlinks=0\nfor path in paths:\n text=path.read_text()\n fences=re.findall(r'^\\s*(`{3,}|~{3,})',text,re.M)\n assert len(fences)%2==0, ('fence',path)\n for match in re.finditer(r'\\[[^\\]\\n]+\\]\\(([^)]+)\\)',text):\n  target=match.group(1).split(' \"')[0].strip('<>')\n  if '://' in target or target.startswith(('mailto:', '/')): continue\n  name, _, anchor=target.partition('#')\n  dest=(path.parent/urllib.parse.unquote(name)).resolve() if name else path\n  assert dest.exists(), ('missing',path,target)\n  if anchor and dest.suffix=='.md':\n   slugs=set()\n   counts={}\n   for heading in re.findall(r'^#{1,6}\\s+(.+?)\\s*#*$',dest.read_text(),re.M):\n    heading=re.sub(r'\\[([^]]+)\\]\\([^)]+\\)',r'\\1',heading)\n    slug=''.join(c for c in heading.lower() if not unicodedata.category(c).startswith(('P','S')) or c in '-_')\n    slug=re.sub(r'\\s','-',slug)\n    count=counts.get(slug,0); counts[slug]=count+1\n    slugs.add(slug+(f'-{count}' if count else ''))\n   assert urllib.parse.unquote(anchor) in slugs, ('anchor',path,target)\n  links+=1\nprint(f'{len(paths)} changed Markdown files: {links} local links/anchors and fences passed')\n",
    "sha256": "ec94316532a9c74f4da91f0aa0c4b4d1e87191f1e4493270fbf89dc828adbed9",
    "actual_result": "15 changed Markdown files: 215 local links/anchors and fences passed",
